# cp secrets/.env.kind-dev.example secrets/.env.kind-dev 후 값을 채운다.
# secrets/.env.kind-dev 는 .gitignore 되어 있다 — 커밋하지 않는다.
POSTGRES_DB=travel_diary_dev
POSTGRES_USER=travel_diary
POSTGRES_PASSWORD=travel_diary_password
REDIS_PASSWORD=travel_diary_redis_password
# HS256 secret — 최소 32 bytes. 4개 서비스 공용.
JWT_SECRET=local-development-jwt-secret-change-me-please
# 선택 — 비워두면 해당 외부 연동만 비활성, 기동에는 지장 없음
GOOGLE_MAPS_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=
